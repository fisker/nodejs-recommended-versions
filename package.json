{
  "name": "nodejs-recommended-versions",
  "version": "5.0.0",
  "description": "Node.js versions you should install",
  "homepage": "https://github.com/fisker/nodejs-recommended-versions#readme",
  "bugs": {
    "url": "https://github.com/fisker/nodejs-recommended-versions/issues"
  },
  "repository": "fisker/nodejs-recommended-versions",
  "funding": "https://github.com/fisker/nodejs-recommended-versions?sponsor=1",
  "license": "MIT",
  "author": {
    "name": "fisker Cheung",
    "email": "lionkay@gmail.com",
    "url": "https://www.fiskercheung.com/"
  },
  "sideEffects": false,
  "type": "module",
  "exports": "./index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "run-p \"build:*\"",
    "build:js": "echo done",
    "clean": "run-p \"clean:*\"",
    "clean:dist": "del-cli dist",
    "dist": "run-p \"dist:*\"",
    "dist:npm": "release-it",
    "fix": "run-p \"fix:*\"",
    "fix:eslint": "yarn lint:eslint --fix",
    "fix:markdown": "yarn lint:markdown --fix",
    "fix:package-json": "sort-package-json \"package.json\" \"packages/*/package.json\"",
    "fix:prettier": "yarn lint:prettier --write",
    "lint": "run-p \"lint:*\"",
    "lint:eslint": "eslint \"**/*.{js,mjs,vue}\"",
    "lint:markdown": "markdownlint \"**/*.md\" --ignore \"**/node_modules/**\"",
    "lint:package-json": "yarn run fix:package-json --check",
    "lint:prettier": "prettier . --check",
    "release": "run-s clean build lint test dist",
    "test": "ava",
    "test-coverage": "c8 ava"
  },
  "ava": {
    "verbose": true
  },
  "c8": {
    "reporter": [
      "lcov",
      "text"
    ]
  },
  "dependencies": {
    "all-node-versions": "13.0.1"
  },
  "devDependencies": {
    "@fisker/eslint-config": "15.4.0",
    "@fisker/eslint-config-ava": "4.2.0",
    "@fisker/prettier-config": "5.3.0",
    "@fisker/release-it-config": "6.0.2",
    "ava": "8.0.1",
    "c8": "11.0.0",
    "del-cli": "7.0.0",
    "eslint": "9.39.4",
    "markdownlint-cli": "0.48.0",
    "npm-run-all2": "9.0.1",
    "prettier": "3.8.3",
    "release-it": "20.2.0",
    "sort-package-json": "3.7.0"
  },
  "packageManager": "yarn@4.16.0",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
